# ---------------------------------------------------------------
# Copy to .env and adjust. All values are validated on startup.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Browser origins allowed to call the API (Vite dev server)
CLIENT_ORIGINS=http://localhost:5173
# Built frontend served by this server in production (relative to backend/)
FRONTEND_DIST=../frontend/dist

# MySQL connection (user needs CREATE privileges for `npm run db:setup`)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=dashboard_builder
DB_CONNECTION_LIMIT=10

# Auth - use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Set to true when served over HTTPS (secure cookies + HSTS)
COOKIE_SECURE=false

# Max image upload size in MB (1-20)
UPLOAD_MAX_MB=5
